<Window x:Class="KhelrunAI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHELRUN AI — Settings"
        Icon="pack://application:,,,/Assets/KhelrunAI.ico" Width="640" Height="820" MinHeight="520" MinWidth="520"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22">

                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="DarkRadio" Content="Dark" GroupName="theme" Margin="0,0,24,0" Checked="Theme_Checked"/>
                    <RadioButton x:Name="LightRadio" Content="Light" GroupName="theme" Checked="Theme_Checked"/>
                </StackPanel>

                <TextBlock Text="Chat text size" Margin="0,14,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                               Text="{Binding Value, ElementName=FontSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="FontSlider" Minimum="11" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </DockPanel>

                <TextBlock Text="Assistant personality" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,0"/>
                <TextBlock Text="System prompt (applies to new chats)" Margin="0,10,0,4"/>
                <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="170"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}"
                         Padding="10,8" BorderThickness="1"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Default" Click="Preset_Click" Tag="default" Padding="12,6" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                    <Button Content="Unrestricted" Click="Preset_Click" Tag="unrestricted" Padding="12,6" Margin="0,0,8,8"/>
                    <Button Content="Coder" Click="Preset_Click" Tag="coder" Padding="12,6" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                    <Button Content="Concise" Click="Preset_Click" Tag="concise" Padding="12,6" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                    <Button Content="Writing coach" Click="Preset_Click" Tag="writer" Padding="12,6" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                </WrapPanel>

                <TextBlock Text="Creativity (temperature)" Margin="0,10,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                               Text="{Binding Value, ElementName=TempSlider, StringFormat={}{0:F1}}"/>
                    <Slider x:Name="TempSlider" Minimum="0" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <TextBlock Text="Lower is more focused; higher is more creative." Foreground="{DynamicResource Muted}" FontSize="12"/>

                <TextBlock Text="Maximum reply length (tokens)" Margin="0,14,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                               Text="{Binding Value, ElementName=TokensSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="TokensSlider" Minimum="128" Maximum="8192" TickFrequency="128" IsSnapToTickEnabled="True"/>
                </DockPanel>

                <TextBlock Text="Web search" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,0"/>
                <CheckBox x:Name="WebCheck" Content="Add web results to questions" Margin="0,10,0,0"/>
                <TextBlock Text="Results per search" Margin="0,10,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                               Text="{Binding Value, ElementName=ResultsSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="ResultsSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </DockPanel>

                <TextBlock Text="Performance &amp; Hardware" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,0"/>
                <TextBlock Text="These apply when the model is reloaded." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,8"/>

                <TextBlock Text="GPU offload (layers)" Margin="0,6,0,4"/>
                <DockPanel>
                    <TextBlock x:Name="GpuLayersLabel" DockPanel.Dock="Right" Width="70" TextAlignment="Right" Text="Auto"/>
                    <Slider x:Name="GpuLayersSlider" Minimum="-1" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="GpuLayersSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock Text="-1 = Auto (max layers the GPU can hold). 0 = CPU only. Higher = more layers on GPU = much faster."
                           Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Text="Context size (tokens of memory per chat)" Margin="0,14,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                               Text="{Binding Value, ElementName=ContextSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="ContextSlider" Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <TextBlock Text="Larger context remembers more of the conversation but uses more RAM/VRAM."
                           Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Text="CPU threads (0 = auto)" Margin="0,14,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                               Text="{Binding Value, ElementName=ThreadSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="ThreadSlider" Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </DockPanel>

                <TextBlock Text="Batch size (prompt processing)" Margin="0,14,0,4"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="50" TextAlignment="Right"
                               Text="{Binding Value, ElementName=BatchSlider, StringFormat={}{0:F0}}"/>
                    <Slider x:Name="BatchSlider" Minimum="128" Maximum="2048" TickFrequency="128" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <TextBlock Text="Higher batch speeds up the initial prompt evaluation, especially on GPU."
                           Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Text="Startup" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,0"/>
                <CheckBox x:Name="AutoLoadCheck" Content="Auto-load last used model on launch" Margin="0,10,0,0"/>
                <CheckBox x:Name="AutoBestCheck" Content="Auto-recommend &amp; offer to download best model for this PC" Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" Padding="20,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource GhostButton}" Padding="20,10" Margin="0,0,12,0"/>
                <Button Content="Save settings" Click="Save_Click" Padding="20,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>