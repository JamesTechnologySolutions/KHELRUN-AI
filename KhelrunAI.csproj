<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KhelrunAI</AssemblyName>
    <RootNamespace>KhelrunAI</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Bundle the .NET runtime so users don't need to install anything. -->
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT single-file: llama.cpp's native libraries must stay as normal files next to the exe.
         The installer gives the one-file download experience instead. -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Version info shown in file properties and the installer. -->
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <Product>KHELRUN AI</Product>
    <Company>JTS</Company>
    <Authors>JTS (James Technology Solutions)</Authors>
    <Description>KHELRUN AI — Private, unrestricted local AI by JTS. Works on any CPU + GPU (CUDA 11/12, Vulkan, pure CPU).</Description>
    <Copyright>Copyright (c) 2026 JTS</Copyright>
    <AssemblyTitle>KHELRUN AI</AssemblyTitle>
    <ApplicationIcon>Assets\KhelrunAI.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- AI models are intentionally never bundled. Users download/import them separately. -->

  <ItemGroup>
    <None Include="legal\EULA.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="legal\PrivacyPolicy.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\KhelrunAI.ico" />
    <None Include="Assets\KhelrunAI.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Maximum compatibility backends (all same version).
         LLamaSharp auto-selects the best available at runtime:
         CUDA 12 (best for modern NVIDIA) → CUDA 11 (older NVIDIA) → Vulkan (AMD/Intel/NVIDIA without CUDA) → CPU. -->
    <PackageReference Include="LLamaSharp" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda11" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.25.0" />
  </ItemGroup>

</Project>