<Window x:Class="KhelrunAI.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHELRUN AI — Models"
        Icon="pack://application:,,,/Assets/KhelrunAI.ico" Width="720" Height="640" MinWidth="560" MinHeight="420"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,22,28,6">
            <TextBlock Text="Model library" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                       Text="Download curated chat models tuned for your hardware, or import any GGUF (chat) or image model file. Everything runs offline after download."/>
        </StackPanel>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,12,28,4">
            <Button x:Name="TabChat" Content="💬  Chat models" Click="TabChat_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button x:Name="TabImage" Content="🎨  Image models" Style="{StaticResource GhostButton}"
                    Click="TabImage_Click" Padding="16,8"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel" Margin="28,12,28,12"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource Panel}" Padding="20,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="BrowseBtn" Content="Import local file…" Click="Browse_Click" Style="{StaticResource GhostButton}" DockPanel.Dock="Left"/>
                <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
